APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Local: true. Staging and production: false (Debugbar and stack traces must stay off).
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Debugbar follows APP_DEBUG unless this is set. Production/staging: false.
DEBUGBAR_ENABLED=false
# Never show signup OTP in the UI. The /_debug/registration-otp lookup stays off unless this is true.
REGISTRATION_OTP_DEBUG=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true on HTTPS production. false for local http://
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CRM_NOTIFICATIONS_ENABLED=true
CRM_NOTIFICATIONS_APPOINTMENTS_ENABLED=true
CRM_NOTIFICATIONS_OFFERS_ENABLED=true
CRM_NOTIFICATIONS_REPAIRS_ENABLED=true
CRM_NOTIFICATIONS_TENANCIES_ENABLED=true
CRM_NOTIFICATIONS_COMPLIANCE_ENABLED=true
CRM_NOTIFICATIONS_FINANCE_ENABLED=true

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Signup OTPs use this mailer (SMTP Settings also writes MAIL_DRIVER; both are kept in sync).
# log will not deliver verification codes. Production: smtp, ses, postmark, or mailgun.
MAIL_MAILER=smtp
MAIL_DRIVER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# UK property address lookup
# postcodes_io: free/no key, postcode and locality data (manual premise line)
# nominatim: free OpenStreetMap search; explicit searches only, moderate usage
# getaddress / ideal_postcodes: full premise addresses; API key required
ADDRESS_LOOKUP_PROVIDER=postcodes_io
ADDRESS_LOOKUP_LIMIT=100

# Provider API base URLs (override only when using a proxy or self-hosted API)
POSTCODES_IO_BASE_URL=https://api.postcodes.io
GETADDRESS_BASE_URL=https://api.getAddress.io
IDEAL_POSTCODES_BASE_URL=https://api.ideal-postcodes.co.uk/v1
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

GETADDRESS_API_KEY=
IDEAL_POSTCODES_API_KEY=

# Required if ADDRESS_LOOKUP_PROVIDER=nominatim. Identify your application and
# keep public Nominatim usage below one request/second.
NOMINATIM_USER_AGENT="${APP_NAME} address lookup (${APP_URL})"
NOMINATIM_CONTACT_EMAIL=

# MHCLG Energy Performance Certificates (optional; free Open Data Communities key)
EPC_OPEN_DATA_EMAIL=
EPC_OPEN_DATA_API_KEY=

# Landlord Property Passport wizard is retired in favour of the overlay flow.
# Set true only to restore the old three-step wizard.
LANDLORD_WIZARD_ENABLED=false

# Chimnie property data. Test mode returns deterministic UK records without an API key.
CHIMNIE_TEST_MODE=true
CHIMNIE_API_KEY=
CHIMNIE_BASE_URL=https://api.chimnie.com
CHIMNIE_TIMEOUT=12

# Business Stripe (subscriptions / operating bank)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Client-money Stripe (tenant rent / client or trust bank). Production must
# use a different Stripe account than STRIPE_SECRET. Staging may leave these
# blank to reuse the test keys above.
STRIPE_RENT_KEY=
STRIPE_RENT_SECRET=
STRIPE_RENT_WEBHOOK_SECRET=
STRIPE_RENT_CURRENCY=gbp
# Optional Connect: client-money account so the card fee lands on the business account.
STRIPE_RENT_CONNECTED_ACCOUNT_ID=
RENT_PAYMENT_FEE_PERCENT=0
RENT_PAYMENT_FEE_FIXED=0
RENT_PAYMENT_FEE_LABEL="Card payment fee"
