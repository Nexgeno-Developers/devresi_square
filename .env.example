APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CRM_NOTIFICATIONS_ENABLED=true
CRM_NOTIFICATIONS_APPOINTMENTS_ENABLED=true
CRM_NOTIFICATIONS_OFFERS_ENABLED=true
CRM_NOTIFICATIONS_REPAIRS_ENABLED=true
CRM_NOTIFICATIONS_TENANCIES_ENABLED=true
CRM_NOTIFICATIONS_COMPLIANCE_ENABLED=true
CRM_NOTIFICATIONS_FINANCE_ENABLED=true

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# UK property address lookup
# postcodes_io: free/no key, postcode and locality data (manual premise line)
# nominatim: free OpenStreetMap search; explicit searches only, moderate usage
# getaddress / ideal_postcodes: full premise addresses; API key required
ADDRESS_LOOKUP_PROVIDER=postcodes_io
ADDRESS_LOOKUP_LIMIT=100

# Provider API base URLs (override only when using a proxy or self-hosted API)
POSTCODES_IO_BASE_URL=https://api.postcodes.io
GETADDRESS_BASE_URL=https://api.getAddress.io
IDEAL_POSTCODES_BASE_URL=https://api.ideal-postcodes.co.uk/v1
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

GETADDRESS_API_KEY=
IDEAL_POSTCODES_API_KEY=

# Required if ADDRESS_LOOKUP_PROVIDER=nominatim. Identify your application and
# keep public Nominatim usage below one request/second.
NOMINATIM_USER_AGENT="${APP_NAME} address lookup (${APP_URL})"
NOMINATIM_CONTACT_EMAIL=

# Chimnie property data. Test mode returns deterministic UK records without an API key.
CHIMNIE_TEST_MODE=true
CHIMNIE_API_KEY=
CHIMNIE_BASE_URL=https://api.chimnie.com
CHIMNIE_TIMEOUT=12
